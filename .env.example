# mock = scripted tool calls, works offline with no AWS account (default)
# bedrock = Strands Agents SDK + Amazon Bedrock
LLM_PROVIDER=mock

# Needed only for LLM_PROVIDER=bedrock and for Polly voice
AWS_REGION=us-east-1
BEDROCK_MODEL=us.amazon.nova-lite-v1:0
# AWS credentials come from the usual places (aws configure, AWS_PROFILE, env vars)

# Server and app
HEARTH_HOST=127.0.0.1
HEARTH_PORT=8765
HEARTH_DB=hearth.db
HEARTH_TZ=Asia/Kolkata
# Pin "now" for a repeatable demo recording, e.g. Tuesday morning:
# HEARTH_NOW=2026-10-20T10:00:00+05:30
